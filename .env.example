# Copiá este archivo a .env.local para desarrollo local.
# Ninguna de estas variables es obligatoria: sin ANTHROPIC_API_KEY,
# Surco funciona igual en modo de demostración (respuestas deterministas).

# Clave de la API de Anthropic (Claude). Si se configura, las respuestas sobre
# evidencia recuperada se redactan con el modelo en vez del modo de demostración.
# Se usa SOLO en el servidor (rutas de API); nunca se expone al navegador.
ANTHROPIC_API_KEY=

# Modelo a usar si ANTHROPIC_API_KEY está configurada. Opcional.
ANTHROPIC_MODEL=claude-sonnet-5
